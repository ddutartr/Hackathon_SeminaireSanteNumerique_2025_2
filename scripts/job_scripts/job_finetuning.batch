#!/bin/bash
#SBATCH --job-name=pipeline_finetuning_cdechaux_1
#SBATCH --partition=routage
#SBATCH --gres=gpu:3g.70gb:1
#SBATCH -c 8    
#SBATCH -e /mnt/eds_projets/inria_hackathon/dev/cdechaux/logs/err-%j.err
#SBATCH -o /mnt/eds_projets/inria_hackathon/dev/cdechaux/logs/out-%j.out


# --- Lancement ---
# attention a bien adapter --text-col si on veut finetuner sur les textes reecrits
/mnt/eds_projets/inria_hackathon/dev/cdechaux/pt_env/bin/python -u /mnt/eds_projets/inria_hackathon/dev/cdechaux/Hackathon_SeminaireSanteNumerique_2025_2/scripts/train_finetune_dp.py \
  --input-csv /mnt/eds_projets/inria_hackathon/data/hackathon_train.csv \
  --text-col observationBlob \
  --label-col code_split \
  --output-dir /mnt/eds_projets/inria_hackathon/eval/cdechaux/checkpoints/camembert_dp_ft_2_brut \
  --pretrained /mnt/eds_projets/inria_hackathon/eval/cdechaux/checkpoints/camembert_dp_ft_1_brut/final \
  --epochs 3 --batch-size 16 --lr 2e-5 --fp16

