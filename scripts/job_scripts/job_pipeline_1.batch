#!/bin/bash
#SBATCH --job-name=pipeline_ssn_cdechaux_1
#SBATCH --partition=routage
#SBATCH --gres=gpu:3g.70gb:1
#SBATCH -c 8    
#SBATCH -e /mnt/eds_projets/inria_hackathon/dev/cdechaux/logs/err-%j.err
#SBATCH -o /mnt/eds_projets/inria_hackathon/dev/cdechaux/logs/out-%j.out

# --- Lancement ---
/mnt/eds_projets/inria_hackathon/dev/cdechaux/pt_env/bin/python -u /mnt/eds_projets/inria_hackathon/dev/cdechaux/Hackathon_SeminaireSanteNumerique_2025_2/scripts/run_pipeline.py \
  --input-csv /mnt/eds_projets/inria_hackathon/data/hackathon_inference.csv \
  --output-csv /mnt/eds_projets/inria_hackathon/eval/cdechaux/cdechaux_test_2.csv \
  --mode predict \
  --backend transformer \
  --col-dp code_split \
  --col-text observationBlob \
  --col-sejour index_col \
  --bundle-path /mnt/eds_projets/inria_hackathon/eval/cdechaux/

